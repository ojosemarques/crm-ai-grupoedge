  createdByActorId    String               @db.Uuid
  updatedByActorId    String               @db.Uuid
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)

  @@unique([workspaceId, id])
  @@unique([workspaceId, name])
  @@index([workspaceId, active, name])
  @@map("financial_accounts")
}

model FinancialEntry {
  id                 String                  @id @default(uuid()) @db.Uuid
  workspaceId        String                  @db.Uuid
  categoryId         String                  @db.Uuid
  financialAccountId String                  @db.Uuid
  customerAccountId  String?                 @db.Uuid
  costCenterId       String?                 @db.Uuid
  recurrenceId       String?                 @db.Uuid
  installmentNumber  Int?
  direction          FinancialEntryDirection
  status             FinancialEntryStatus    @default(PLANNED)
  description        String
  counterparty       String?
  amountCents        BigInt
  currency           Currency                @default(BRL)
  competenceAt       DateTime                @db.Timestamptz(3)
  dueAt              DateTime                @db.Timestamptz(3)
  settledAt          DateTime?               @db.Timestamptz(3)
  cancelledAt        DateTime?               @db.Timestamptz(3)
  cancellationReason String?
  approvalStatus     FinancialApprovalStatus @default(NOT_REQUIRED)
  approvalReason     String?
  approvedAt         DateTime?               @db.Timestamptz(3)
  approvedByActorId  String?                 @db.Uuid
  idempotencyKey     String
  revision           Int                     @default(1)
  createdByActorId   String                  @db.Uuid
  updatedByActorId   String                  @db.Uuid
  createdAt          DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @db.Timestamptz(3)

  @@unique([workspaceId, id])
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, status, dueAt])
  @@index([workspaceId, direction, competenceAt])
  @@index([workspaceId, financialAccountId, settledAt])
  @@index([workspaceId, customerAccountId, dueAt])
  @@map("financial_entries")
}

model FinancialCostCenter {
