  status              ConsumptionBudgetStatus @default(ACTIVE)
  currency            String                  @default("BRL")
  limitCents          BigInt?
  limitUnits          BigInt?
  includedCreditCents BigInt                  @default(0)
  warningBasisPoints  Int                     @default(8000)
  periodStart         DateTime                @db.Timestamptz(3)
  periodEnd           DateTime                @db.Timestamptz(3)
  pausedAt            DateTime?               @db.Timestamptz(3)
  pausedReason        String?
  revision            Int                     @default(1)
  createdByActorId    String                  @db.Uuid
  updatedByActorId    String                  @db.Uuid
  createdAt           DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                @updatedAt @db.Timestamptz(3)

  workspace Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdBy Actor                    @relation("ConsumptionBudgetCreatedBy", fields: [workspaceId, createdByActorId], references: [workspaceId, id], onDelete: Restrict)
  updatedBy Actor                    @relation("ConsumptionBudgetUpdatedBy", fields: [workspaceId, updatedByActorId], references: [workspaceId, id], onDelete: Restrict)
  ledger    ConsumptionLedgerEntry[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, resourceType, resourceKey, periodStart])
  @@index([workspaceId, status, periodEnd])
  @@map("consumption_budgets")
}

model ConsumptionLedgerEntry {
  id                String                  @id @default(uuid()) @db.Uuid
  workspaceId       String                  @db.Uuid
  budgetId          String                  @db.Uuid
  resourceType      ConsumptionResourceType
  resourceKey       String
  kind              ConsumptionLedgerKind
  amountCents       BigInt                  @default(0)
  units             BigInt                  @default(0)
  idempotencyKey    String
  externalReference String?
  reason            String?
  metadata          Json                    @default("{}")
  actorId           String                  @db.Uuid
  occurredAt        DateTime                @db.Timestamptz(3)
  createdAt         DateTime                @default(now()) @db.Timestamptz(3)

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  budget    ConsumptionBudget @relation(fields: [workspaceId, budgetId], references: [workspaceId, id], onDelete: Restrict)
  actor     Actor             @relation(fields: [workspaceId, actorId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, budgetId, occurredAt])
  @@index([workspaceId, resourceType, resourceKey, occurredAt])
  @@map("consumption_ledger_entries")
}

enum FinancialCategoryKind {
  INCOME
  EXPENSE
}

enum FinancialAccountType {
  CASH
  BANK
  OTHER
}

enum FinancialEntryDirection {
  INCOME
  EXPENSE
}

enum FinancialEntryStatus {
  PLANNED
  SETTLED
  CANCELLED
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
}

enum FinancialApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum BankStatementLineStatus {
  UNMATCHED
  MATCHED
  IGNORED
}

enum FinancialRecurrenceFrequency {
  MONTHLY
}

enum CommissionBasis {
  TCV
  SALE_AMOUNT
  MRR
}

enum CommissionTrigger {
  SALE
  RECEIPT
}

model FinancialCategory {
  id               String                @id @default(uuid()) @db.Uuid
  workspaceId      String                @db.Uuid
  key              String
  name             String
  kind             FinancialCategoryKind
  dreGroup         String?
  active           Boolean               @default(true)
  createdByActorId String                @db.Uuid
  updatedByActorId String                @db.Uuid
  createdAt        DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @db.Timestamptz(3)

  @@unique([workspaceId, id])
  @@unique([workspaceId, key])
  @@index([workspaceId, kind, active, name])
  @@map("financial_categories")
}

model FinancialAccount {
  id                  String               @id @default(uuid()) @db.Uuid
  workspaceId         String               @db.Uuid
  name                String
  type                FinancialAccountType
  currency            Currency             @default(BRL)
  openingBalanceCents BigInt               @default(0)
