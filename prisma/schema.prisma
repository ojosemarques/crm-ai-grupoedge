  updatedByActorId String            @db.Uuid
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)

  @@unique([workspaceId, id])
  @@index([workspaceId, sellerMemberId, active, effectiveFrom])
  @@map("commission_rules")
}

model Commission {
  id                String           @id @default(uuid()) @db.Uuid
  workspaceId       String           @db.Uuid
  ruleId            String           @db.Uuid
  sellerMemberId    String           @db.Uuid
  opportunityId     String           @db.Uuid
  contractId        String?          @db.Uuid
  paymentId         String?          @db.Uuid
  status            CommissionStatus @default(PENDING)
  basisCents        BigInt
  percentageBps     Int
  amountCents       BigInt
  currency          Currency         @default(BRL)
  earnedAt          DateTime         @db.Timestamptz(3)
  approvedAt        DateTime?        @db.Timestamptz(3)
  approvedByActorId String?          @db.Uuid
  paidAt            DateTime?        @db.Timestamptz(3)
  paidByActorId     String?          @db.Uuid
  idempotencyKey    String
  revision          Int              @default(1)
  createdByActorId  String           @db.Uuid
  updatedByActorId  String           @db.Uuid
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)

  payment Payment? @relation(fields: [workspaceId, paymentId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@unique([workspaceId, idempotencyKey])
  @@unique([workspaceId, ruleId, paymentId])
  @@index([workspaceId, opportunityId, ruleId])
  @@index([workspaceId, sellerMemberId, status, earnedAt])
  @@index([workspaceId, status, paidAt])
  @@map("commissions")
}

