model LocalCredential {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @unique @db.Uuid
  passwordHash      String    @db.Text
  credentialVersion Int       @default(1)
  failedAttempts    Int       @default(0)
  lockedUntil       DateTime? @db.Timestamptz(3)
  passwordChangedAt DateTime  @default(now()) @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([lockedUntil])
  @@map("local_credentials")
}

model AuthSession {
  id                String    @id @default(uuid()) @db.Uuid
  workspaceId       String    @db.Uuid
  userId            String    @db.Uuid
  workspaceMemberId String    @db.Uuid
  actorId           String    @db.Uuid
  tokenHash         String    @unique @db.Char(64)
  credentialVersion Int
  expiresAt         DateTime  @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt         DateTime? @db.Timestamptz(3)
  ipAddress         String?   @db.Inet
  userAgent         String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user      User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  member    WorkspaceMember @relation(fields: [workspaceId, userId, workspaceMemberId], references: [workspaceId, userId, id], onDelete: Restrict)
  actor     Actor           @relation(fields: [workspaceId, actorId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@index([workspaceId, workspaceMemberId, revokedAt, expiresAt])
  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt, revokedAt])
  @@map("auth_sessions")
}

model Role {
  id               String    @id @default(uuid()) @db.Uuid
  workspaceId      String    @db.Uuid
  key              String
  name             String
  description      String?
  isSystem         Boolean   @default(false)
  createdByActorId String    @db.Uuid
  updatedByActorId String    @db.Uuid
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime? @db.Timestamptz(3)

  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdBy   Actor             @relation("RoleCreatedBy", fields: [workspaceId, createdByActorId], references: [workspaceId, id], onDelete: Restrict)
  updatedBy   Actor             @relation("RoleUpdatedBy", fields: [workspaceId, updatedByActorId], references: [workspaceId, id], onDelete: Restrict)
  memberships WorkspaceMember[]
  permissions RolePermission[]

  @@unique([workspaceId, id])
  @@index([workspaceId, key, deletedAt])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id               String          @id @default(uuid()) @db.Uuid
  workspaceId      String          @db.Uuid
  roleId           String          @db.Uuid
  permissionId     String          @db.Uuid
  scope            PermissionScope @default(WORKSPACE)
  createdByActorId String          @db.Uuid
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  role       Role       @relation(fields: [workspaceId, roleId], references: [workspaceId, id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  createdBy  Actor      @relation("RolePermissionCreatedBy", fields: [workspaceId, createdByActorId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

