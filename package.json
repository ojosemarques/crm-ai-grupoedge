{
  "name": "politizai-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "packageManager": "pnpm@11.14.0",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "pnpm db:generate && next build --webpack",
    "start": "next start",
    "worker": "tsx src/modules/automations/worker.ts",
    "worker:staging:homologate": "tsx scripts/run-staging-worker-homologation.ts",
    "admin:bootstrap": "tsx scripts/run-administrative-bootstrap.ts",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:ai:evals": "tsx scripts/run-ai-evals.ts",
    "test:integration": "tsx scripts/run-integration-tests.ts",
    "test:crm29": "tsx scripts/run-crm29-tests.ts",
    "test:watch": "vitest",
    "test:e2e": "tsx scripts/run-e2e-tests.ts",
    "test:e2e:cross-browser": "tsx scripts/run-cross-browser-e2e-tests.ts tests/e2e/prod10-cross-browser.spec.ts",
    "ci:smoke": "tsx scripts/run-ci-smoke.ts",
    "security:scan": "tsx scripts/run-repository-policy.ts",
    "release:report": "tsx scripts/generate-release-gate-report.ts",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:staging:homologate": "tsx scripts/run-staging-homologation.ts",
    "db:seed": "prisma db seed",
    "db:contacts:backfill": "tsx scripts/run-contact-backfill.ts",
    "db:accounts:backfill": "tsx scripts/run-account-backfill.ts",
    "db:lifecycle:backfill": "tsx scripts/run-lifecycle-backfill.ts",
    "db:privacy:backfill": "tsx scripts/run-privacy-backfill.ts",
    "db:marketing:backfill": "tsx scripts/run-marketing-attribution-backfill.ts",
    "db:geography:backfill": "tsx scripts/run-geographic-backfill.ts",
    "db:omnichannel:backfill": "tsx scripts/run-omnichannel-backfill.ts",
    "db:whatsapp:backfill": "tsx scripts/run-whatsapp-backfill.ts",
    "db:email:backfill": "tsx scripts/run-email-backfill.ts",
    "db:telephony:backfill": "tsx scripts/run-telephony-backfill.ts",
    "db:calendar:backfill": "tsx scripts/run-calendar-backfill.ts",
    "db:contracts:backfill": "tsx scripts/run-contract-backfill.ts",
    "db:revenue:backfill": "tsx scripts/run-revenue-backfill.ts",
    "db:payments:backfill": "tsx scripts/run-payment-backfill.ts",
    "db:onboarding:backfill": "tsx scripts/run-onboarding-backfill.ts",
    "db:customer-success:backfill": "tsx scripts/run-customer-success-backfill.ts",
    "db:customer-service:backfill": "tsx scripts/run-customer-service-backfill.ts",
    "db:farmer:backfill": "tsx scripts/run-farmer-backfill.ts",
    "db:operations:backfill": "tsx scripts/run-operations-backfill.ts",
    "db:goals:backfill": "tsx scripts/run-goal-backfill.ts",
    "db:forecast:backfill": "tsx scripts/run-forecast-backfill.ts",
    "db:demo:reset": "tsx scripts/reset-demo-schema.ts",
    "db:test:migrate": "prisma migrate deploy --config prisma.test.config.ts",
    "db:test:cleanup": "tsx scripts/cleanup-test-schemas.ts",
    "resilience:restore": "tsx scripts/run-resilience-restore.ts",
    "resilience:load": "tsx scripts/run-resilience-load.ts",
    "readiness:preflight": "tsx scripts/run-production-preflight.ts --target=local",
    "test:resilience": "vitest run src/modules/resilience/domain/resilience-domain.test.ts",
    "test:resilience:integration": "tsx scripts/run-resilience-tests.ts",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "next": "16.3.4",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.2",
    "@types/pg": "8.15.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
