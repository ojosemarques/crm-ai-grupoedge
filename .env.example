# Copie este arquivo para .env. Estes valores servem apenas para desenvolvimento local.
APP_NAME="Grupo Edge CRM"
APP_ENV="local"
PROCESS_ROLE="web"
APP_CANONICAL_URL="http://localhost:3000"
APP_TRUSTED_HOSTS="localhost,127.0.0.1"
APP_TRUSTED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
APP_TIME_ZONE="America/Sao_Paulo"
LOG_LEVEL="info"
LOG_FORMAT="pretty"
PORT="3000"
AUTH_SESSION_TTL_HOURS="8"
AUTH_MAX_FAILED_ATTEMPTS="5"
AUTH_LOCK_MINUTES="15"
AUTOMATION_WORKER_ID="worker-local-1"
AUTOMATION_POLL_INTERVAL_MS="1000"
AUTOMATION_BATCH_SIZE="10"
AUTOMATION_LOCK_TIMEOUT_SECONDS="60"
AUTOMATION_BACKOFF_BASE_SECONDS="5"
AUTOMATION_WORKER_ENABLED="false"
SERVERLESS_WORKER_ENABLED="false"
SERVERLESS_WORKER_SECRET=""
SERVERLESS_WORKER_MAX_JOBS="10"
SERVERLESS_WORKER_MAX_DURATION_MS="40000"
SESSION_COOKIE_SECURE="false"
SESSION_COOKIE_HTTP_ONLY="true"
SESSION_COOKIE_SAME_SITE="lax"
EXTERNAL_ADAPTERS_MODE="disabled"
# Prospecção Ativa/Open-Dot: JSON server-side com clientes separados para
# pesquisa, auditoria e e-mail. Cada segredo deve ter >=32 caracteres e vir do
# cofre do ambiente; não use valores reais neste arquivo nem na interface.
# Exemplo de forma (substitua IDs e segredo somente no cofre):
# [{"clientId":"open-dot-research","workspaceId":"UUID","actorId":"UUID","scopes":["RESEARCH_WRITE","RESEARCH_READ"],"currentSecret":"VALOR_DO_COFRE_COM_32_OU_MAIS_CARACTERES"}]
OPEN_DOT_CLIENTS_JSON=""
# MillionSend: segredos somente no cofre server-side. MILLIONSEND_ENABLED ativa
# o conector, mas o disparo da cadência continua bloqueado por emailEgressEnabled.
MILLIONSEND_ENABLED="false"
MILLIONSEND_API_KEY=""
MILLIONSEND_WEBHOOK_SECRET=""
MILLIONSEND_OPEN_DOT_CLIENT_ID="open-dot-email"
MILLIONSEND_OPEN_DOT_SECRET=""
DEMO_SEED_ENABLED="true"
DEMO_CREDENTIALS_ENABLED="true"
DEMO_DATA_MODE="local"
ADMIN_BOOTSTRAP_ENABLED="false"

POSTGRES_DB="politizai_crm"
POSTGRES_USER="politizai"
POSTGRES_PASSWORD="politizai_local_only"
POSTGRES_PORT="5432"
DATABASE_URL="postgresql://politizai:politizai_local_only@localhost:5432/politizai_crm?schema=public"
DIRECT_URL="postgresql://politizai:politizai_local_only@localhost:5432/politizai_crm?schema=public"
DATABASE_EXPECTED_HOST="localhost"
DATABASE_EXPECTED_DIRECT_HOST="localhost"
DATABASE_EXPECTED_NAME="politizai_crm"
DATABASE_EXPECTED_SCHEMA="public"

# Usado pelo Playwright. Mantenha uma porta separada da execução manual.
PLAYWRIGHT_BASE_URL="http://127.0.0.1:3100"

# Depuração excepcional: o padrão é remover sempre o schema efêmero.
KEEP_TEST_SCHEMA="0"

# CRM-50 — segredo opcional apenas para assinar callbacks no sandbox local.
# Vazio usa uma chave conhecida exclusivamente de teste; nunca use em produção.
PAYMENT_SANDBOX_WEBHOOK_SECRET=""

# Etapa 15 — HMAC do provedor de checkout transacional. Obrigatório em produção,
# com pelo menos 32 caracteres. O valor nunca é retornado pelas APIs autenticadas.
CHECKOUT_WEBHOOK_SECRET=""

# CRM-40 — referências server-side opcionais. Nunca cole estes valores na UI,
# documentação, commit, log ou banco. Sem token, o conector permanece pendente.
META_ADS_ACCESS_TOKEN=""
META_ADS_APP_SECRET=""
META_ADS_WEBHOOK_VERIFY_TOKEN=""
# Dataset/Píxel da Conversions API; o worker bloqueia egress enquanto estiver vazio.
META_ADS_DATASET_ID=""

# CRM-41 — referências server-side opcionais. São nomes fixos consumidos somente
# pelo servidor; mantenha os valores vazios até uma validação externa autorizada.
GOOGLE_ADS_OAUTH_CLIENT_ID=""
GOOGLE_ADS_OAUTH_CLIENT_SECRET=""
GOOGLE_ADS_OAUTH_REFRESH_TOKEN=""
GOOGLE_ADS_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_ADS_SERVICE_ACCOUNT_PRIVATE_KEY=""
# Compatibilidade temporária: a API atual ignora este header, mas versões antigas
# ainda podem exigi-lo durante uma janela de migração. Não cole na interface.
GOOGLE_ADS_DEVELOPER_TOKEN=""

# Google Calendar por usuário. Segredo e chave de cifragem existem apenas no
# cofre server-side; nunca use prefixo NEXT_PUBLIC_ nem persista tokens em claro.
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=""

# Copilot operacional: segredo apenas no servidor. Escolha o modelo habilitado na
# sua conta OpenAI; ativar o flag autoriza envio do contexto mínimo permitido pelo RBAC.
OPENAI_API_KEY=""
OPENAI_MODEL=""
COPILOT_EXTERNAL_ENABLED="false"
