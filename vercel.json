{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "pnpm build:vercel",
  "regions": ["yul1"],
  "crons": [
    {
      "path": "/api/internal/worker/tick",
      "schedule": "* * * * *"
    }
  ],
  "functions": {
    "src/app/api/**/*": {
      "maxDuration": 60
    }
  }
}
