# Modelo documental de produção. Preencha no cofre da plataforma; não versionar valores reais.
# Identidade do runtime. APP_ENV/NODE_ENV/PROCESS_ROLE não admitem fallback em nuvem.
APP_NAME=""
APP_ENV=""
NODE_ENV=""
PROCESS_ROLE=""
APP_CANONICAL_URL=""
APP_TRUSTED_HOSTS=""
APP_TRUSTED_ORIGINS=""
APP_TIME_ZONE=""
# Observabilidade server-side; LOG_FORMAT deve ser explicitamente estruturado.
LOG_LEVEL=""
LOG_FORMAT=""
AUTH_SESSION_TTL_HOURS=""
AUTH_MAX_FAILED_ATTEMPTS=""
AUTH_LOCK_MINUTES=""
# Política fixa do cookie de sessão; valores são validados antes do uso remoto.
SESSION_COOKIE_SECURE=""
SESSION_COOKIE_HTTP_ONLY=""
SESSION_COOKIE_SAME_SITE=""
# DATABASE_URL pertence ao runtime pooled. DIRECT_URL existe somente no runner
# isolado de migrations e deve ser removida de web, worker e bootstrap.
DATABASE_URL=""
DIRECT_URL=""
DATABASE_EXPECTED_HOST=""
DATABASE_EXPECTED_DIRECT_HOST=""
DATABASE_EXPECTED_NAME=""
DATABASE_EXPECTED_SCHEMA=""
# O worker é um processo separado; este inventário não cria nem agenda o worker.
AUTOMATION_WORKER_ENABLED=""
AUTOMATION_WORKER_ID=""
AUTOMATION_POLL_INTERVAL_MS=""
AUTOMATION_BATCH_SIZE=""
AUTOMATION_LOCK_TIMEOUT_SECONDS=""
AUTOMATION_BACKOFF_BASE_SECONDS=""
# Tick serverless exige decisão arquitetural e segredo exclusivo no cofre.
SERVERLESS_WORKER_ENABLED=""
SERVERLESS_WORKER_SECRET=""
SERVERLESS_WORKER_MAX_JOBS=""
SERVERLESS_WORKER_MAX_DURATION_MS=""
# Controles que mantêm providers e conteúdo demonstrativo desativados em nuvem.
EXTERNAL_ADAPTERS_MODE=""
DEMO_SEED_ENABLED=""
DEMO_CREDENTIALS_ENABLED=""
DEMO_DATA_MODE=""
ADMIN_BOOTSTRAP_ENABLED=""
# Variáveis abaixo são efêmeras e só existem durante a execução manual autorizada.
ADMIN_BOOTSTRAP_SECRET=""
ADMIN_BOOTSTRAP_CONFIRMATION=""
ADMIN_BOOTSTRAP_IDEMPOTENCY_KEY=""
ADMIN_BOOTSTRAP_WORKSPACE_SLUG=""
ADMIN_BOOTSTRAP_WORKSPACE_NAME=""
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_DISPLAY_NAME=""
ADMIN_BOOTSTRAP_PASSWORD=""

# Copilot: configurar somente no servidor; habilitar autoriza o contexto mínimo
# do workspace permitido ao usuário a sair para a API oficial OpenAI.
OPENAI_API_KEY=""
OPENAI_MODEL=""
COPILOT_EXTERNAL_ENABLED="false"
